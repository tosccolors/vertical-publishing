#. module: sale_advertising_order
#: model:mail.template,body_html:sale_advertising_order.mail_template_sale_confirmation_ads
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"box-sizing:border-box;margin: 0px; padding: 0px; font-size: 12px;\">\n"
"Dear <t t-if=\"object.partner_id.name\">\n"
"                <span style=\"font-weight:bold;\" t-out=\"object.partner_id.name or "
"''\"></span>\n"
"            </t>,\n"
"        <br><br>\n"
"        <t t-set=\"transaction\" t-value=\"object.get_portal_last_transaction()\"></"
"t>\n"
"        Attached you will find your order with number <span style=\"font-weight:bold;"
"\" t-out=\"object.name or ''\"></span>. \n"
"        <t t-if=\"object.state == 'sale' or (transaction and transaction.state in "
"('done', 'authorized'))\">\n"
"            Your order has been confirmed.\n"
"        </t>\n"
"        <t t-elif=\"transaction and transaction.state == 'pending'\">\n"
"            Your order confirmation is pending. It will be confirmed when the "
"payment is received.\n"
"            <t t-if=\"object.reference\">\n"
"                Your payment reference is <span style=\"font-weight:bold;\" t-"
"out=\"object.reference or ''\"></span>.\n"
"            </t>\n"
"        </t>\n"
"        <br>\n"
"       <br>Please contact me in case of any questions you might have.\n"
"        <t t-if=\"not is_html_empty(object.user_id.signature)\">\n"
"            <br><br>\n"
"            <t t-out=\"object.user_id.signature or ''\"><br></t>\n"
"        </t>\n"
"        <br><br>\n"
"    </p>\n"
"\n"
"\n"
"</div>"
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"box-sizing:border-box;margin: 0px; padding: 0px; font-size: 12px;\">\n"
"Beste <t t-if=\"object.partner_id.name\">\n"
"                <span style=\"font-weight:bold;\" t-out=\"object.partner_id.name or "
"''\"></span>\n"
"            </t>,\n"
"        <br><br>\n"
"        <t t-set=\"transaction\" t-value=\"object.get_portal_last_transaction()\"></"
"t>\n"
"        In de bijlage kunt u uw order vinden met nummer <span style=\"font-"
"weight:bold;\" t-out=\"object.name or ''\"></span>. \n"
"        <t t-if=\"object.state == 'sale' or (transaction and transaction.state in "
"('done', 'authorized'))\">\n"
"            Uw order is bevestigd.\n"
"        </t>\n"
"        <t t-elif=\"transaction and transaction.state == 'pending'\">\n"
"            De order zal worden bevestigd zodra wij uw betaling hebben ontvangen.\n"
"            <t t-if=\"object.reference\">\n"
"                Uw betalingsreferentie is <span style=\"font-weight:bold;\" t-"
"out=\"object.reference or ''\"></span>.\n"
"            </t>\n"
"        </t>\n"
"        <br>\n"
"       <br>Mocht u nog vragen hebben, neem dan gerust contact met mij op.\n"
"        <t t-if=\"not is_html_empty(object.user_id.signature)\">\n"
"            <br><br>\n"
"            <t t-out=\"object.user_id.signature or ''\"><br></t>\n"
"        </t>\n"
"        <br><br>\n"
"    </p>\n"
"\n"
"\n"
"</div>"

#. module: sale_advertising_order
#: model:mail.template,body_html:sale_advertising_order.email_template_edi_sale_ads
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"box-sizing:border-box;margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        <t t-set=\"doc_name\" t-value=\"'quotation' if object.state in ('draft', "
"'sent') else 'order'\"></t>\n"
"Dear <t t-if=\"object.partner_id.name\">\n"
"                <span style=\"font-weight:bold;\" t-out=\"object.partner_id.name or "
"''\"></span>\n"
"            </t>,\n"
"<br><br>\n"
"        Your\n"
"        <t t-if=\"ctx.get('proforma')\">\n"
"            Pro forma invoice for <t t-out=\"doc_name or ''\">quotation</t> <span "
"style=\"font-weight: bold;\" t-out=\"object.name or ''\"></span>\n"
"            <t t-if=\"object.origin\">\n"
"                (with reference: <t t-out=\"object.origin or ''\"></t> )\n"
"            </t>\n"
"             is available.\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            <t t-out=\"doc_name or ''\">quotation</t> <span style=\"font-weight: "
"bold;\" t-out=\"object.name or ''\"></span>\n"
"            <t t-if=\"object.origin\">\n"
"                (with reference: <t t-out=\"object.origin or ''\"></t> )\n"
"            </t>\n"
"             is ready for review.\n"
"        </t>\n"
"        <br><br>\n"
"        Do not hesitate to contact us if you have any questions.\n"
"        <t t-if=\"not is_html_empty(object.user_id.signature)\">\n"
"            <br><br>\n"
"            <t t-out=\"object.user_id.signature or ''\"><br></t>\n"
"        </t>\n"
"        <br><br>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"box-sizing:border-box;margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        <t t-set=\"doc_name\" t-value=\"'quotation' if object.state in ('draft', "
"'sent') else 'order'\"></t>\n"
"Beste <t t-if=\"object.partner_id.name\">\n"
"                <span style=\"font-weight:bold;\" t-out=\"object.partner_id.name or "
"''\"></span>\n"
"            </t>,\n"
"<br><br>\n"
"        In de bijlage vindt u uw\n"
"        <t t-if=\"ctx.get('proforma')\">\n"
"            Pro forma invoice for <t t-out=\"doc_name or ''\">offerte met nummer </"
"t> <span style=\"font-weight: bold;\" t-out=\"object.name or ''\"></span>\n"
"            <t t-if=\"object.client_order_ref\">\n"
"                (met referentie: <t t-out=\"object.client_order_ref or ''\"></t> )\n"
"            </t>.\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            <t t-out=\"doc_name or ''\">offerte met nummer </t> <span style=\"font-"
"weight: bold;\" t-out=\"object.name or ''\"></span>\n"
"            <t t-if=\"object.client_order_ref\">\n"
"                (met referentie: <t t-out=\"object.client_order_ref or ''\"></t> )\n"
"            </t>.\n"
"        </t>\n"
"        <br><br>\n"
"        Please contact me in case of any questions you might have.\n"
"        <t t-if=\"not is_html_empty(object.user_id.signature)\">\n"
"            <br><br>\n"
"            <t t-out=\"object.user_id.signature or ''\"><br></t>\n"
"        </t>\n"
"        <br><br>\n"
"    </p>\n"
"</div>\n"
"            "

