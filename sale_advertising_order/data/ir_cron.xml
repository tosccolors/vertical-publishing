<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_auto_validate_invoices" model="ir.cron">
        <field name="name">Auto Validate Invoices</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="pytz.timezone(obj().env.user.tz).localize(datetime.now().replace(hour=21, minute=0, second=0)).astimezone(pytz.utc).replace(tzinfo=None)" model="ir.cron" />
        <field name="model_id" ref="account.model_account_move" />
        <field name="code">model._cron_auto_validate_invoices()</field>
    </record>
</odoo>
