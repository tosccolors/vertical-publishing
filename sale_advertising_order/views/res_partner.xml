<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!--
        Partner: (form)
    -->
  <record id="view_partner_form_inherit" model="ir.ui.view">
    <field name="name">res.partner.form.inherit.sao</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form" />
    <field eval="19" name="priority" />
    <field name="arch" type="xml">
      <xpath expr="//group[@name='misc']" position="inside">
        <field name="is_ad_agency" />
        <field
          name="agency_discount"
          attrs="{'invisible': [('is_ad_agency', '=', False)]}"
        />
      </xpath>

      <xpath expr="//field[@name='child_ids']" position="attributes">
        <attribute name="context" operation="update">
          {"default_is_customer": is_customer, "default_is_supplier": is_supplier}
        </attribute>
      </xpath>
      <button name="action_view_sale_order" position="after">
        <button
          class="oe_stat_button"
          type="object"
          name="action_view_sao_order"
          groups="sale_advertising_order.group_ads_sales_user"
          icon="fa-book"
        >
          <field string="Ad Sales" name="sao_order_count" widget="statinfo" />
        </button>
      </button>
    </field>
  </record>

  <!--
        Partner: (search)
    -->
  <record id="view_res_partner_filter_inherit" model="ir.ui.view">
    <field name="name">res.partner.view.search.inherit.sao</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_res_partner_filter" />
    <field name="arch" type="xml">
      <xpath expr="//filter[@name='inactive']" position="before">
        <separator />
        <filter
          string="Agencies"
          name="agency"
          domain="[('is_ad_agency','=',1),('parent_id', '=', False)]"
          help="Ad Agencies"
        />
      </xpath>
    </field>
  </record>

  <record id="crm_lead_partner_kanban_view" model="ir.ui.view">
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="sale.crm_lead_partner_kanban_view" />
    <field name="arch" type="xml">
      <field name="sale_order_count" position="after">
        <field
          name="sao_order_count"
          groups="sale_advertising_order.group_ads_sales_user"
        />
      </field>
      <xpath expr="//a[@data-name='action_view_sale_order']" position="after">
        <a
          t-if="record.sao_order_count.value > 0"
          data-type="object"
          data-name="action_view_sao_order"
          groups="sale_advertising_order.group_ads_sales_user"
          href="#"
          class="oe_kanban_action oe_kanban_action_a me-1"
        >
          <span class="badge rounded-pill">
            <i
              class="fa fa-fw fa-book"
              role="img"
              aria-label="Ad Sales"
              title="Ad Sales"
            />
            <t t-out="record.sao_order_count.value" />
          </span>
        </a>
      </xpath>
    </field>
  </record>
</odoo>
