<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
  <record model="ir.module.category" id="module_ad4all_portal">
    <field name="name">Ad4all Portal User</field>
    <field name="sequence">30</field>
  </record>

  <record id="group_ad4all_portal_user" model="res.groups">
    <field name="name">Ad4all Portal User</field>
    <field name="category_id" ref="module_ad4all_portal" />
    <field name="users" eval="[Command.link(ref('base.user_admin'))]" />
  </record>

  <record id="rule_ad4all_config" model="ir.rule">
    <field name="name">Ad4all.config multicompany</field>
    <field name="model_id" ref="model_ad4all_config" />
    <field name="domain_force">
      ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
    </field>
  </record>
</odoo>
